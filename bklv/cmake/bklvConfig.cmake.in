@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(SDL3 CONFIG)
if("@BKLV_WITH_WEBP@" STREQUAL "ON")
    if(NOT TARGET WebP::sharpyuv)
        add_library(WebP::sharpyuv STATIC IMPORTED)
        set_target_properties(WebP::sharpyuv PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libsharpyuv.a")
    endif()
    if(NOT TARGET WebP::webp)
        add_library(WebP::webp STATIC IMPORTED)
        set_target_properties(WebP::webp PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libwebp.a"
            INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
            INTERFACE_LINK_LIBRARIES WebP::sharpyuv)
    endif()
    if(NOT TARGET WebP::webpdemux)
        add_library(WebP::webpdemux STATIC IMPORTED)
        set_target_properties(WebP::webpdemux PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libwebpdemux.a"
            INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
            INTERFACE_LINK_LIBRARIES WebP::webp)
    endif()
endif()
if("@BKLV_GRAPHICS@" STREQUAL "gl")
    find_dependency(OpenGL)
elseif("@BKLV_GRAPHICS@" STREQUAL "vk")
    find_dependency(Vulkan)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/bklvTargets.cmake")

if(NOT TARGET bklv::bklv)
    add_library(bklv::bklv INTERFACE IMPORTED)
    set_target_properties(bklv::bklv PROPERTIES
        INTERFACE_LINK_LIBRARIES bklv::bklv_sdk)
endif()
check_required_components(bklv)
