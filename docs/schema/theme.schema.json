{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bklv theme.json",
  "type": "object",
  "required": ["name", "files"],
  "properties": {
    "name": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "version": { "type": "integer" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "descriptionKey": { "type": "string" },
    "sound": { "type": "string" },
    "colorScheme": { "enum": ["light", "dark"] },
    "files": { "type": "array", "items": { "type": "string", "pattern": "\\.json$" } },
    "behavior": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
  },
  "additionalProperties": true
}
