{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bklv view JSON",
  "type": "object",
  "required": ["type"],
  "properties": {
    "$schema": { "type": "string" },
    "type": { "type": "string" },
    "id": { "type": "string" },
    "children": { "type": "array", "items": { "$ref": "#" } },
    "include": { "type": "string" },
    "bind": { "type": "string" },
    "bindTo": { "type": "string" },
    "onClick": { "type": "string" },
    "visibleIf": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "required": ["field"],
          "properties": { "field": { "type": "string" }, "equals": { "type": "string" } },
          "additionalProperties": false }
      ]
    }
  },
  "additionalProperties": true
}
