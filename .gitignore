# macOS 系统文件。
.DS_Store

# 构建产物和临时目录（dist/ 按后端/平台分子目录，见 AGENTS.md）。
dist/
build/

# C/C++ 编译中间文件。
*.o
*.obj
*.d
*.dSYM/

# 常见编辑器配置。只放行 settings.json：里面是"用哪个 CMake preset"这类
# 本项目特有的设置（VS Code 的 CMake Tools 默认会去构建 build/，而我们是 build/gl）。
.vscode/*
!.vscode/settings.json
.idea/

# ImGui 的 ini 已在代码里通过 io.IniFilename = nullptr 关闭，正常不会生成。
# 这里仍保留忽略规则，兜住手动打开 ini 持久化时产生的文件。
imgui.ini

# 设计器运行时写在可执行文件目录的小记录
dist/designer_project.json
dist/designer_state.json
dist/designer_test_work/
dist/**/*.diff.png
