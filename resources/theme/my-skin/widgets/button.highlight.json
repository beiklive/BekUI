{
  "box": {
    "height": "@theme/metric.control.height",
    "minWidth": "@theme/metric.control.minWidth"
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.button.defaultBg",
      "radius": "@theme/metric.radius.md"
    },
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    },
    {
      "op": "text",
      "id": "title",
      "source": "text",
      "color": "@theme/color.button.highlightText",
      "fontSize": "@theme/metric.button.textSize",
      "align": "center",
      "valign": "center",
      "inset": [
        0,
        25,
        0,
        25
      ]
    },
    {
      "op": "rect",
      "id": "hlGlow",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -6.5,
        -6.5,
        -6.5,
        -6.5
      ]
    },
    {
      "op": "rect",
      "id": "hlBorder",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    }
  ],
  "states": {
    "focused": {
      "hlGlow.stroke": {
        "to": "@theme/color.highlight.glow",
        "duration": 120,
        "easing": "quadraticOut"
      },
      "hlGlow.strokeWidth": {
        "to": 11,
        "duration": 120
      },
      "hlBorder.stroke": {
        "to": "@theme/color.highlight.border",
        "duration": 120,
        "easing": "quadraticOut"
      },
      "hlBorder.strokeWidth": {
        "to": "@theme/metric.highlight.strokeWidth",
        "duration": 120
      }
    },
    "pressed": {
      "bg.fill": {
        "to": "@theme/color.button.defaultPressedBg",
        "duration": 60
      },
      "title.color": {
        "to": "@theme/color.button.highlightText",
        "duration": 60
      }
    },
    "disabled": {
      "bg.fill": {
        "to": "@theme/color.state.disabled",
        "duration": 150
      },
      "title.color": {
        "to": "@theme/color.button.highlightDisabledText",
        "duration": 150
      },
      "bg.stroke": {
        "to": "@theme/color.button.disabledBorder",
        "duration": 150
      }
    }
  }
}
