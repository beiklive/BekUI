{
  "box": {
    "width": "@theme/metric.dropdown.popupWidth",
    "padding": "@theme/metric.spacing.xs",
    "cornerRadius": "@theme/metric.radius.md"
  },
  "layers": [
    {
      "op": "shadow",
      "id": "shadow",
      "fill": "@theme/color.common.shadow",
      "feather": "@theme/metric.shadow.feather",
      "radius": "@theme/metric.shadow.radius",
      "offset": [
        "@theme/metric.shadow.offsetX",
        "@theme/metric.shadow.offsetY"
      ],
      "spread": "@theme/metric.shadow.spread"
    },
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.surface.raised",
      "stroke": "@theme/color.common.divider",
      "strokeWidth": 1,
      "radius": "@theme/metric.radius.md"
    }
  ]
}
