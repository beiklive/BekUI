{
  "box": {
    "width": "100%",
    "height": "@theme/metric.appletFrame.footerHeight",
    "shrink": 0,
    "margin": [
      0,
      "@theme/metric.hints.footerMarginSides",
      0,
      "@theme/metric.hints.footerMarginSides"
    ],
    "padding": [
      "@theme/metric.hints.footerPaddingTopBottom",
      "@theme/metric.hints.footerPaddingSides",
      "@theme/metric.hints.footerPaddingTopBottom",
      "@theme/metric.hints.footerPaddingSides"
    ],
    "alignItems": "stretch",
    "axis": "row"
  },
  "layers": [
    {
      "op": "rect",
      "id": "line",
      "fill": "@theme/color.border.subtle",
      "height": 1,
      "valign": "top"
    }
  ]
}
