{
  "box": {
    "height": "@theme/metric.sidebar.itemHeight",
    "shrink": 0
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "#00000000",
      "radius": "@theme/metric.radius.md"
    },
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "#00000000",
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    },
    {
      "op": "rect",
      "id": "accent",
      "fill": "#00000000",
      "radius": 2,
      "width": "@theme/metric.sidebar.accentWidth",
      "inset": [
        "@theme/metric.sidebar.accentMarginY",
        0,
        "@theme/metric.sidebar.accentMarginY",
        "@theme/metric.sidebar.accentMarginX"
      ],
      "align": "left"
    },
    {
      "op": "text",
      "id": "title",
      "source": "text",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.sidebar.itemFontSize",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        16,
        0,
        20
      ]
    },
    {
      "op": "rect",
      "id": "hlGlow",
      "stroke": "#00000000",
      "strokeWidth": 0,
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -6.5,
        -6.5,
        -6.5,
        -6.5
      ]
    },
    {
      "op": "rect",
      "id": "hlBorder",
      "stroke": "#00000000",
      "strokeWidth": 0,
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    }
  ],
  "states": {
    "selected": {
      "accent.fill": {
        "to": "@theme/color.sidebar.activeItem",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "title.color": {
        "to": "@theme/color.sidebar.activeItem",
        "duration": 140
      }
    },
    "focused": {
      "hlBg.fill": {
        "to": "@theme/color.highlight.background",
        "duration": 120,
        "easing": "quadraticOut"
      },
      "hlGlow.stroke": {
        "to": "@theme/color.highlight.glow",
        "duration": 120,
        "easing": "quadraticOut"
      },
      "hlGlow.strokeWidth": {
        "to": 11,
        "duration": 120
      },
      "hlBorder.stroke": {
        "to": "@theme/color.highlight.border",
        "duration": 120,
        "easing": "quadraticOut"
      },
      "hlBorder.strokeWidth": {
        "to": "@theme/metric.highlight.strokeWidth",
        "duration": 120
      }
    }
  }
}
