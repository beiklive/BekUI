{
  "box": {
    "width": "100%",
    "height": "auto",
    "padding": "@theme/metric.card.padding",
    "gap": "@theme/metric.spacing.sm"
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color/surface.raised",
      "radius": "@theme/metric.radius.lg"
    },
    {
      "op": "shadow",
      "id": "innerShadow",
      "inner": true,
      "fill": "@theme/color.common.shadow",
      "feather": 16,
      "spread": 2,
      "radius": "@theme/metric.radius.lg"
    }
  ]
}
