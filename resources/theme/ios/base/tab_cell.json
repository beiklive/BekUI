{
  "box": {
    "height": "@theme/metric.tabCell.height",
    "shrink": 0
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.radius.sm"
    },
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    },
    {
      "op": "rect",
      "id": "accent",
      "fill": "#00000000",
      "radius": 2,
      "width": 0,
      "inset": [
        10,
        0,
        10,
        6
      ],
      "align": "left"
    },
    {
      "op": "text",
      "id": "title",
      "source": "text",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.font.size.lg",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        16,
        0,
        20
      ]
    },
    {
      "op": "rect",
      "id": "hlGlow",
      "stroke": "@theme/color.common.transparent",
      "strokeWidth": 0,
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -6.5,
        -6.5,
        -6.5,
        -6.5
      ]
    },
    {
      "op": "rect",
      "id": "hlBorder",
      "stroke": "@theme/color.common.transparent",
      "strokeWidth": 0,
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    }
  ],
  "states": {
    "selected": {
      "accent.fill": {
        "to": "@theme/color.accent.base",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "bg.fill": {
        "to": "@theme/color.state.focus",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "title.color": {
        "to": "@theme/color.text.primary",
        "duration": 140
      }
    },
    "focused": {
      "hlBg.fill": {
        "to": "@theme/color.highlight.background",
        "duration": 120,
        "easing": "quadraticOut"
      }
    }
  }
}
