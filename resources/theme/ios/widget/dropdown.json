{
  "box": {
    "width": "100%",
    "height": "@theme/metric.dropdown.height",
    "padding": [
      "@theme/metric.spacing.sm",
      "@theme/metric.spacing.md",
      "@theme/metric.spacing.sm",
      "@theme/metric.spacing.md"
    ]
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.button.defaultBg",
      "stroke": "@theme/color.button.defaultBorder",
      "strokeWidth": 2,
      "radius": "@theme/metric.radius.md"
    },
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "title",
      "color": "@theme/color.text.dim",
      "fontSize": "@theme/metric.font.size.md",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        40
      ]
    },
    {
      "op": "text",
      "id": "value",
      "data_id": "value",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.font.size.md",
      "align": "right",
      "valign": "center"
    },
    {
      "op": "rect",
      "id": "hlGlow",
      "stroke": "@theme/color.common.transparent",
      "strokeWidth": 0,
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -6.5,
        -6.5,
        -6.5,
        -6.5
      ]
    },
    {
      "op": "rect",
      "id": "hlBorder",
      "stroke": "@theme/color.common.transparent",
      "strokeWidth": 0,
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    }
  ],
  "states": {
    "focused": {
      "hlBg.fill": {
        "to": "@theme/color.highlight.background",
        "duration": 120,
        "easing": "quadraticOut"
      }
    }
  }
}
