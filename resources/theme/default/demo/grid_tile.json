{
  "$comment": "示例专用外观（不在 base 里）：虚拟化网格里的一格 —— 居中的图标 + 底部标题。",
  "box": {
    "width": "100%",
    "height": "100%",
    "axis": "column"
  },
  "requires": {
    "content": ["icon", "title"],
    "layers": ["bg"]
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "radius": 12,
      "fill": "@theme/color.surface.card",
      "stroke": "@theme/color.border.subtle",
      "strokeWidth": 1,
      "inset": [4, 4, 8, 4]
    },
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "font_kind": "icon",
      "fontSize": 26,
      "color": "@theme/color.accent.base",
      "align": "center",
      "valign": "center",
      "inset": [4, 4, 16, 4]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "title",
      "fontSize": 14,
      "color": "@theme/color.text.primary",
      "align": "center",
      "valign": "bottom",
      "inset": [0, 4, 14, 4]
    }
  ]
}
