{
  "import": "base/box.component",
  "box": {
    "axis": "row",
    "alignItems": "center",
    "justifyContent": "center",
    "width": 48,
    "height": 48,
    "padding": 0,
    "minWidth": 0
  },
  "layers": [
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.component.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    },
    {
      "op": "text",
      "id": "icon",
      "source": "icon",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.buttonVariant.iconSize",
      "align": "center",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        0
      ]
    },
    {
      "op": "rect",
      "id": "hlGlow",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.component.radius",
      "inset": [
        -6.5,
        -6.5,
        -6.5,
        -6.5
      ]
    },
    {
      "op": "rect",
      "id": "hlBorder",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.component.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    }
  ],
  "states": {
    "focused": {
      "hlGlow.stroke": {
        "to": "@theme/color.highlight.glow",
        "duration": 120,
        "easing": "quadraticOut"
      },
      "hlGlow.strokeWidth": {
        "to": 11,
        "duration": 120
      },
      "hlBorder.stroke": {
        "to": "@theme/color.highlight.border",
        "duration": 120,
        "easing": "quadraticOut"
      },
      "hlBorder.strokeWidth": {
        "to": "@theme/metric.highlight.strokeWidth",
        "duration": 120
      }
    },
    "disabled": {
      "icon.color": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      },
      "bg.stroke": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      }
    }
  }
}
