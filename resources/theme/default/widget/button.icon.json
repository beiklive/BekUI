{
  "import": "base/box.component",
  "box": {
    "axis": "row",
    "alignItems": "center",
    "justifyContent": "center",
    "width": 48,
    "height": 48,
    "padding": 0,
    "minWidth": 0
  },
  "layers": [
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.component.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    },
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.buttonVariant.iconSize",
      "align": "center",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        0
      ],
      "font_kind": "icon"
    }
  ],
  "states": {
    "focused": {},
    "disabled": {
      "icon.color": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      },
      "bg.stroke": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      }
    }
  }
}
