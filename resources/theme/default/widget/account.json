{
  "box": {
    "width": "@theme/metric.account.width",
    "height": "@theme/metric.account.height",
    "axis": "row",
    "gap": "@theme/metric.account.gap",
    "alignItems": "center",
    "shrink": 0,
    "margin": [
      0,
      4,
      0,
      4
    ]
  },
  "layers": [
    {
      "op": "rect",
      "id": "avatar",
      "fill": "@theme/color.account.avatar",
      "width": "@theme/metric.account.avatarSize",
      "height": "@theme/metric.account.avatarSize",
      "radius": "@theme/metric.account.avatarRadius",
      "align": "left"
    },
    {
      "op": "text",
      "id": "initial",
      "data_id": "initial",
      "color": "@theme/color.account.initial",
      "fontSize": "@theme/metric.account.initialFontSize",
      "align": "left",
      "valign": "center",
      "width": "@theme/metric.account.avatarSize",
      "height": "@theme/metric.account.avatarSize"
    }
  ]
}
