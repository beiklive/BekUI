{
  "box": {
    "width": "@theme/metric.editTextDialog.width",
    "height": "auto",
    "padding": "@theme/metric.spacing.lg",
    "gap": "@theme/metric.spacing.md",
    "justifyContent": "flex_end"
  },
  "layers": [
    {
      "op": "rect",
      "id": "panel",
      "fill": "@theme/color.surface.card",
      "stroke": "@theme/color.border.default",
      "strokeWidth": 1,
      "radius": "@theme/metric.radius.lg"
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "title",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.font.size.title",
      "align": "left",
      "valign": "top",
      "inset": [
        16,
        20,
        0,
        20
      ]
    }
  ],
  "states": {
    "open": {
      "panel.opacity": {
        "to": 1,
        "duration": 160,
        "easing": "quadraticOut"
      },
      "panel.offsetY": {
        "to": 0,
        "duration": 160,
        "easing": "quadraticOut"
      }
    },
    "closed": {
      "panel.opacity": {
        "to": 0,
        "duration": 140
      },
      "panel.offsetY": {
        "to": 24,
        "duration": 140
      }
    }
  }
}
