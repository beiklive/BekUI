{
  "import": "base/box.component",
  "box": {
    "axis": "row",
    "alignItems": "center",
    "gap": "@theme/metric.buttonVariant.gap"
  },
  "layers": [
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.component.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    },
    {
      "op": "text",
      "id": "icon",
      "source": "icon",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.buttonVariant.iconSize",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        0
      ],
      "font": "icon"
    },
    {
      "op": "text",
      "id": "text",
      "source": "text",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.font.size.md",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        36
      ]
    },
    {
      "op": "rect",
      "id": "hlGlow",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.component.radius",
      "inset": [
        -6.5,
        -6.5,
        -6.5,
        -6.5
      ]
    },
    {
      "op": "rect",
      "id": "hlBorder",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.component.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    }
  ],
  "states": {
    "focused": {},
    "disabled": {
      "icon.color": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      },
      "text.color": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      },
      "bg.stroke": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      }
    }
  }
}
