{
  "import": "base/box.component",
  "box": {
    "axis": "row",
    "alignItems": "center",
    "gap": "@theme/metric.buttonVariant.gap"
  },
  "layers": [
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.component.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    },
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.buttonVariant.iconSize",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        0
      ],
      "font_kind": "icon"
    },
    {
      "op": "text",
      "id": "text",
      "data_id": "text",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.font.size.md",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        66,
        0,
        36
      ]
    },
    {
      "op": "rect",
      "id": "track",
      "width": "@theme/metric.buttonVariant.switchWidth",
      "height": "@theme/metric.buttonVariant.switchHeight",
      "align": "right",
      "valign": "center",
      "radius": "@theme/metric.radius.round",
      "fill": "@theme/color.common.greyDark"
    },
    {
      "op": "rect",
      "id": "knob",
      "width": "@theme/metric.buttonVariant.switchKnob",
      "height": "@theme/metric.buttonVariant.switchKnob",
      "align": "right",
      "valign": "center",
      "radius": "@theme/metric.radius.round",
      "fill": "@theme/color.common.white",
      "inset": [
        0,
        3,
        0,
        3
      ]
    }
  ],
  "states": {
    "focused": {},
    "on": {
      "track.fill": {
        "to": "@theme/color.accent.base",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "knob.offsetX": {
        "to": -22,
        "duration": 140,
        "easing": "quadraticOut"
      }
    },
    "off": {
      "track.fill": {
        "to": "@theme/color.common.greyDark",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "knob.offsetX": {
        "to": 0,
        "duration": 140,
        "easing": "quadraticOut"
      }
    },
    "disabled": {
      "icon.color": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      },
      "text.color": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      },
      "bg.stroke": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      }
    }
  }
}
