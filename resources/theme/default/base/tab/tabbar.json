{
  "$comment": "顶部水平标签条：高 56、左右 20 内边距、项间距 8，底部一条 1px 分隔线。竖直版见 base/tab/tabbar.vertical。",
  "box": {
    "width": "100%",
    "height": 56,
    "axis": "row",
    "gap": 8,
    "padding": [0, "@theme/metric.spacing.lg", 0, "@theme/metric.spacing.lg"],
    "justifyContent": "center",
    "alignItems": "center"
  },
  "requires": {
    "layers": [
      { "surface": "rect" },
      { "separator": "rect" }
    ]
  },
  "layers": [
    {
      "op": "rect",
      "id": "surface",
      "fill":  "@theme/color.common.transparent"
    },
    {
      "op": "rect",
      "id": "separator",
      "height": 1,
      "valign": "bottom",
      "fill": "@theme/color.border.subtle"
    }
  ]
}