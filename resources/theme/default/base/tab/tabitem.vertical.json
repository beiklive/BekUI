{
  "$comment": "左侧竖直标签条里的一项：占满条宽、高 44，图标左、文字靠左；选中时浅蓝药丸 + 左边一条 3px 强调竖条。",
  "import": "base/tab/tabitem",
  "box": {
    "width": "100%",
    "height": 44,
    "axis": "row",
    "justifyContent": "flexStart",
    "alignItems": "center"
  },  
  "requires": {
    "content": ["icon", "label"],
    "layers": ["bg", "indicator"]
  },
  "layers": [
    {
      "op": "rect",
      "id": "indicator",
      "width": 3,
      "height": 30,
      "radius": 2,
      "align": "left",
      "valign": "center",
      "opacity": 0,
      "fill": "@theme/color.accent.base"
    }
  ]
}