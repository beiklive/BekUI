{
  "$comment": "水平标签条里的一项：112×36，圆角 10，左图标 + 紧跟的文字；选中态是浅蓝底 + 强调色文字。",
  "box": {
    "width": 112,
    "height": 36,
    "axis": "row",
    "justifyContent": "flexStart",
    "alignItems": "center",
      "radius" : 15
  },
  "requires": {
    "content": ["icon", "label"],
    "layers": ["bg"]
  },
  "layers": [
    {
      "import": "base/layer/shadow",
      "radius" : 15
    },
    {
      "import": "base/layer/border",
      "stroke": "@theme/color.button.defaultBorder",
      "radius" : 15
    },
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "font_kind": "icon",
      "fontSize": 18,
      "color": "@theme/color.text.dim",
      "width": 20,
      "align": "left",
      "valign": "center",
      "inset": [0, 0, 0, 16]
    },
    {
      "op": "text",
      "id": "label",
      "data_id": "label",
      "fontSize": 15,
      "color": "@theme/color.text.dim",
      "align": "left",
      "valign": "center",
      "inset": [0, 0, 0, 46]
    },
    {
      "op": "rect",
      "id": "indicator",
      "height": 3,
      "width": 80,
      "radius": 2,
      "align": "center",
      "valign": "bottom",
      "opacity": 0,
      "fill": "@theme/color.accent.base"
    }
  ],
  "states": {
    "on": {
      "indicator.opacity": { "to": 1.0, "duration": 10 }
    },
    "off": {
      "indicator.opacity": { "to": 0.0, "duration": 10 }
    }
  }
}