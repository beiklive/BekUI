{
  "$comment": "水平标签条里的一项：112×36，圆角 10，左图标 + 紧跟的文字；选中态是浅蓝底 + 强调色文字。",
  "box": {
    "width": 112,
    "height": 36,
    "axis": "row",
    "justifyContent": "flexStart",
    "alignItems": "center"
  },
  "requires": {
    "content": ["icon", "label"],
    "layers": ["bg"]
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "radius": "@theme/metric.radius.lg",
      "fill": "@theme/color.common.transparent"
    },
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "font_kind": "icon",
      "fontSize": 18,
      "color": "@theme/color.text.dim",
      "width": 20,
      "align": "left",
      "valign": "center",
      "inset": [0, 0, 0, 16]
    },
    {
      "op": "text",
      "id": "label",
      "data_id": "label",
      "fontSize": 15,
      "color": "@theme/color.text.dim",
      "align": "left",
      "valign": "center",
      "inset": [0, 0, 0, 46]
    }
  ],
  "states": {
    "on": {
      "bg.fill": { "to": "@theme/color.highlight.background", "duration": 120 },
      "icon.color": { "to": "@theme/color.accent.base", "duration": 120 },
      "label.color": { "to": "@theme/color.accent.base", "duration": 120 }
    },
    "off": {
      "bg.fill": { "to": "@theme/color.common.transparent", "duration": 120 },
      "icon.color": { "to": "@theme/color.text.dim", "duration": 120 },
      "label.color": { "to": "@theme/color.text.dim", "duration": 120 }
    }
  }
}