{
    "$comment": "一节的小标题：左侧主信息（title）、右侧副信息（info），最左边一条竖条（bar）。改颜色/字号/竖条宽度都在这里调。",
    "box": {
        "width": "100%",
        "height": 34,
        "axis": "row",
        "alignItems": "center",
        "justifyContent": "spaceBetween",
        "padding": [0, 12, 0, 12]
    },
    "layers": [
        {
            "op": "rect",
            "id": "bar",
            "width": 3,
            "height": 16,
            "radius": 2,
            "align": "left",
            "valign": "center",
            "fill": "@theme/color.accent.base"
        },
        {
            "op": "text",
            "id": "title",
            "data_id": "title",
            "fontSize": 18,
            "color": "@theme/color.text.dim",
            "align": "left",
            "valign": "center",
            "inset": [0, 0, 0, 14]
        },
        {
            "op": "text",
            "id": "info",
            "data_id": "info",
            "fontSize": 14,
            "color": "@theme/color.common.textMuted",
            "align": "right",
            "valign": "center"
        }
    ],
    "requires": {
        "content": ["title", "info"],
        "layers": [
            { "bar": "rect" },
            { "title": "text" },
            { "info": "text" }
        ]
    }
}
