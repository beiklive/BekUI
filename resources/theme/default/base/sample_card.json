{
  "box": {
    "axis": "row",
    "gap": 12,
    "padding": 12,
    "alignItems": "center"
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.surface.card",
      "radius": 14,
      "stroke": "@theme/color.border.subtle",
      "strokeWidth": 1
    }
  ],
  "children": [
    {
      "appearance": "base/tab_cell.sidebar",
      "box": {
        "width": 40,
        "height": 40
      },
      "icon": "@icon/star"
    },
    {
      "box": {
        "axis": "column",
        "gap": 4,
        "grow": 1
      },
      "children": [
        {
          "appearance": "base/json_demo.title",
          "text": "标题"
        },
        {
          "appearance": "base/json_demo.title",
          "text": "副标题"
        }
      ]
    },
    {
      "box": {
        "width": 8
      }
    }
  ],
  "states": {
    "pressed": {
      "bg.fill": {
        "to": "@theme/color.accent.base",
        "duration": 120
      }
    }
  },
  "transitions": {
    "enter": {
      "alpha": {
        "from": 0,
        "to": 1,
        "duration": 200
      }
    }
  }
}
