{
  "box": {
    "width": "100%",
    "height": 92,
    "padding": [
      16,
      20,
      16,
      20
    ],
    "gap": 10,
    "cornerRadius": 14,
    "shrink": 0
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.surface.card",
      "radius": 14,
      "stroke": "@theme/color.accent.base",
      "strokeWidth": 2
    },
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "@theme/color.highlight.background",
      "radius": 12
    },
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "color": "@theme/color.accent.base",
      "fontSize": 28,
      "width": 36,
      "align": "left",
      "valign": "center",
      "font_kind": "icon"
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "color": "@theme/color.text.primary",
      "fontSize": 20,
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        46
      ]
    }
  ]
}
