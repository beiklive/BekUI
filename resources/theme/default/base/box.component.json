{
  "import": [
    "base/box",
    "base/glass_surface"
  ],
  "box": {
    "measureContent": "sum",
    "padding": [
      "@theme/metric.component.paddingY",
      "@theme/metric.component.paddingX",
      "@theme/metric.component.paddingY",
      "@theme/metric.component.paddingX"
    ]
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "#00000000",
      "stroke": "@theme/color.common.white",
      "strokeWidth": "@theme/metric.component.borderWidth",
      "radius": "@theme/metric.component.radius"
    }
  ]
}
