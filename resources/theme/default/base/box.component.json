{
  "import": [
    "base/box",
    "base/glass_surface"
  ],
  "vars": {
    "colors": {
      "none": "@theme/color.common.transparent",
      "line": "@theme/color.common.white"
    },
    "numbers": {
      "padY":  "@theme/metric.component.paddingY",
      "padX":  "@theme/metric.component.paddingX",
      "radius": "@theme/metric.component.radius",
      "border": "@theme/metric.component.borderWidth"
    }
  },
  "box": {
    "measureContent": "sum",
    "padding": [
      "&number.padY",
      "&number.padX",
      "&number.padY",
      "&number.padX"
    ]
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "&color.none",
      "stroke": "&color.line",
      "strokeWidth": "&number.border",
      "radius": "&number.radius"
    }
  ]
}
