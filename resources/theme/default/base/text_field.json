{
  "box": {
    "width": "100%",
    "height": "@theme/metric.textField.height"
  },
  "layers": [
    {
      "op": "rect",
      "id": "field",
      "fill": "@theme/color.surface.sunken",
      "stroke": "@theme/color.button.defaultBorder",
      "strokeWidth": 2,
      "radius": "@theme/metric.radius.md"
    },
    {
      "import": "base/layer/hl_bg"
    },
    {
      "op": "text",
      "id": "text",
      "data_id": "text",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.font.size.md",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        12
      ]
    },
    {
      "op": "text",
      "id": "counter",
      "data_id": "counter",
      "color": "@theme/color.text.dim",
      "fontSize": "@theme/metric.font.size.sm",
      "align": "right",
      "valign": "center",
      "inset": [
        0,
        12,
        0,
        0
      ]
    },
    {
      "op": "custom",
      "id": "caret",
      "fill": "@theme/color.accent.base",
      "fontSize": "@theme/metric.font.size.md",
      "inset": [
        10,
        0,
        10,
        12
      ]
    }
  ],
  "states": {
    "focused": {
      "hlBg.fill": {
        "to": "@theme/color.highlight.background",
        "duration": 120,
        "easing": "quadraticOut"
      }
    }
  }
}
