{
  "box": {
    "width": "100%",
    "height": "@theme/metric.cell.height",
    "shrink": 0,
    "axis": "row",
    "alignItems": "center",
    "gap": "@theme/metric.cell.gap",
    "padding": [
      "@theme/metric.cell.paddingY",
      "@theme/metric.cell.paddingX",
      "@theme/metric.cell.paddingY",
      "@theme/metric.cell.paddingX"
    ]
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.cell.background",
      "radius": "@theme/metric.radius.sm"
    },
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "title",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.cell.titleFontSize",
      "valign": "center"
    },
    {
      "op": "custom",
      "id": "switch",
      "data_id": "switch"
    },
    {
      "op": "rect",
      "id": "hlGlow",
      "stroke": "@theme/color.common.transparent",
      "strokeWidth": 0,
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -6.5,
        -6.5,
        -6.5,
        -6.5
      ]
    },
    {
      "op": "rect",
      "id": "hlBorder",
      "stroke": "@theme/color.common.transparent",
      "strokeWidth": 0,
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    }
  ],
  "states": {
    "focused": {
      "hlBg.fill": {
        "to": "@theme/color.highlight.background",
        "duration": 120,
        "easing": "quadraticOut"
      }
    },
    "disabled": {
      "bg.fill": {
        "to": "@theme/color.state.disabled",
        "duration": 150
      },
      "title.color": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      }
    }
  }
}
