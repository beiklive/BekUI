{
  "$comment": "通知卡片（通用）：只画背景 / 描边 / 左侧强调条。图标、图片、文字都是**层**，各自带 data_id 绑定内容槽（icon / text / image），尺寸、颜色、间距、位置全写在这里 —— 改 JSON 就生效，不用改代码。具体形态见 toast_icon / toast_image。横向滑入滑出由代码做（setTranslateX），所以这里没有 offsetX 动画。",
  "box": {
    "width": "@theme/metric.notification.width",
    "height": 50,
    "alignItems": "flexStart",
    "justifyContent": "center",
    "padding": [0, 0, 0, "@theme/metric.notification.paddingX"]
  },
  "layers": [
    {
      "import": "base/layer/shadow",
      "radius": "@theme/metric.notification.radius",
      "inset": [5, 0, 5, 0]
    },
    {
      "import": "base/layer/border",
      "radius": "@theme/metric.notification.radius",
      "inset": [5, 0, 5, 0]
    },
    {
      "op": "rect",
      "id": "bar",
      "fill": "@theme/color.accent.base",
      "radius": 2,
      "width": 4,
      "height": 40,
      "align": "left"
    }
  ],
  "requires": {
    "layers": [{ "shadow": "shadow" }, { "border": "rect" }]
  }
}
