{
  "$comment": "图片 + 文字的通知（ImageNotification）：套通用卡片 toast_base，再叠两层内容 —— image（data_id=image，缩略图）与 title（data_id=text，文案）。缩略图的宽高 / 圆角 / 与文字的间距都在这里调，不用改代码。",
  "import": "base/notification/toast_base",
  "box": {
    "height": 80
  },
  "layers": [
    {
      "op": "image",
      "id": "image",
      "data_id": "image",
      "width": 44,
      "height": 44,
      "radius": 6,
      "align": "left",
      "valign": "center",
      "inset": [0, 0, 0, 20]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "fontSize": 18,
      "color": "@theme/color.notification.text",
      "align": "left",
      "valign": "center",
      "inset": [0, 0, 0, 76]
    }
  ],
  "requires": {
    "content": ["image", "text"]
  }
}
