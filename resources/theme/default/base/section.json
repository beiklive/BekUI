{
  "box": {
    "width": "100%",
    "height": "auto",
    "shrink": 0,
    "padding": [
      "@theme/metric.section.paddingTopBottom",
      0,
      "@theme/metric.section.paddingTopBottom",
      0
    ]
  },
  "layers": [
    {
      "op": "rect",
      "id": "bar",
      "fill": "@theme/color.accent.base",
      "width": "@theme/metric.section.barWidth",
      "radius": 2,
      "align": "left",
      "valign": "center"
    },
    {
      "op": "text",
      "id": "title",
      "source": "text",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.section.fontSize",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        "@theme/metric.section.titleInset"
      ]
    },
    {
      "op": "text",
      "id": "info",
      "source": "info",
      "color": "@theme/color.text.dim",
      "fontSize": "@theme/metric.section.subtitleSize",
      "align": "right",
      "valign": "center"
    },
    {
      "op": "rect",
      "id": "line",
      "fill": "@theme/color.common.divider",
      "height": 1,
      "align": "left",
      "valign": "bottom"
    }
  ]
}
