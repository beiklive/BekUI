{
  "$comment": "通知条：玻璃底 + 描边 + 文本，三层都来自 base/layer/。bg 留着给 hidden/shown 的 opacity / offsetY 动画用。",
  "box": {
    "width": "@theme/metric.notification.width",
    "height": "auto",
    "padding": [
      "@theme/metric.notification.paddingY",
      "@theme/metric.notification.paddingX",
      "@theme/metric.notification.paddingY",
      "@theme/metric.notification.paddingX"
    ],
    "alignItems": "center"
  },
  "layers": [
    {
      "import": "base/layer/glass"
    },
    {
      "import": "base/layer/bg",
      "fill": "@theme/color.common.transparent",
      "stroke": "@theme/color.border.subtle",
      "strokeWidth": 1,
      "radius": "@theme/metric.notification.radius"
    },
    {
      "op": "text",
      "id": "text",
      "data_id": "text",
      "color": "@theme/color.notification.text",
      "fontSize": "@theme/metric.notification.fontSize",
      "valign": "center"
    }
  ],
  "states": {
    "hidden": {
      "bg.opacity": {
        "to": 0.0,
        "duration": 150
      },
      "text.opacity": {
        "to": 0.0,
        "duration": 150
      },
      "bg.offsetY": {
        "to": -12.0,
        "duration": 150
      },
      "text.offsetY": {
        "to": -12.0,
        "duration": 150
      }
    },
    "shown": {
      "bg.opacity": {
        "to": 1.0,
        "duration": 150
      },
      "text.opacity": {
        "to": 1.0,
        "duration": 150
      },
      "bg.offsetY": {
        "to": 0.0,
        "duration": 150
      },
      "text.offsetY": {
        "to": 0.0,
        "duration": 150
      }
    }
  }
}
