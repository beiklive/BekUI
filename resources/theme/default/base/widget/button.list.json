{
  "import": "base/widget/button.text",
  "$comment": "列表按钮：当列表元素用的普通按钮 —— 去掉边框，文字按正常左对齐显示，其余（尺寸/内边距/状态）跟普通按钮一致。",
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "stroke": "@theme/color.common.transparent",
      "strokeWidth": 0
    },
    {
      "op": "text",
      "id": "text",
      "align": "left"
    }
  ],
  "states": {
    "disabled": {
      "text.color": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      },
      "bg.stroke": {
        "to": "@theme/color.common.transparent",
        "duration": 150
      }
    }
  }
}
