{
  "import": "base/box.component",
  "vars": {
    "colors": {
      "none": "@theme/color.common.transparent",
      "label": "@theme/color.text.primary",
      "muted": "@theme/color.text.disabled"
    },
    "numbers": {
      "radius": "@theme/metric.component.radius",
      "gap": -2.5,
      "glow": -6.5,
      "fade": 150,
      "font": "@theme/metric.font.size.md"
    }
  },
  "box": {
    "axis": "row",
    "alignItems": "center",
    "justifyContent": "center"
  },
  "layers": [
    {
      "import": "base/layer/shadow"
    },
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "&color.none",
      "radius": "&number.radius",
      "inset": [
        "&number.gap",
        "&number.gap",
        "&number.gap",
        "&number.gap"
      ]
    },
    {
      "op": "text",
      "id": "text",
      "data_id": "text",
      "color": "&color.label",
      "fontSize": "&number.font",
      "align": "center",
      "valign": "center"
    }
  ],
  "states": {
    "focused": {},
    "disabled": {
      "text.color": {
        "to": "&color.muted",
        "duration": "&number.fade"
      },
      "bg.stroke": {
        "to": "&color.muted",
        "duration": "&number.fade"
      }
    }
  }
}
