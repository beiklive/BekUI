{
  "box": {
    "width": "100%",
    "height": "@theme/metric.cell.height",
    "shrink": 0,
    "axis": "row",
    "alignItems": "center",
    "gap": "@theme/metric.cell.gap",
    "padding": [
      "@theme/metric.cell.paddingY",
      "@theme/metric.cell.paddingX",
      "@theme/metric.cell.paddingY",
      "@theme/metric.cell.paddingX"
    ]
  },
  "layers": [
    {
      "import": "base/layer/cell_bg"
    },
    {
      "import": "base/layer/hl_bg"
    },
    {
      "import": "base/layer/cell_title"
    }
  ],
  "states": {
    "focused": {
      "hlBg.fill": {
        "to": "@theme/color.highlight.background",
        "duration": 120,
        "easing": "quadraticOut"
      }
    },
    "disabled": {
      "bg.fill": {
        "to": "@theme/color.state.disabled",
        "duration": 150
      },
      "title.color": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      }
    }
  }
}
