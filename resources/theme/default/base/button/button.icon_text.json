{
  "$comment": "图标 + 文字按钮：背景 / 边框 / 阴影继承 base/button/button，这里加 m_icon 与 m_text 两层（都用左侧 inset 排队，层不是流式布局）。",
  "import": "base/button/button",
  "box": {
    "height": "@theme/metric.control.height",
    "minWidth": 0,
    "padding": 0,
    "axis": "row",
    "alignItems": "center"
  },
  "layers": [
    {
      "op": "text",
      "id": "icon",
      "data_id": "m_icon",
      "font_kind": "icon",
      "fontSize": "@theme/metric.buttonVariant.iconSize",
      "color": "@theme/color.button.defaultText",
      "width": "@theme/metric.buttonVariant.iconSize",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        20
      ]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "m_text",
      "fontSize": "@theme/metric.buttonVariant.infoFontSize",
      "color": "@theme/color.button.defaultText",
      "align": "center",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        56
      ]
    }
  ]
}
