{
  "$comment": "开关按钮：轨道/旋钮用两张 SVG（resources/img/switch/），on/off 用 opacity 切换",
  "import": [
    "base/button/frame"
  ],
  "layers": [
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "font_kind": "icon",
      "fontSize": "@theme/metric.buttonVariant.iconSize",
      "color": "@theme/color.button.defaultText",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        20
      ]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "fontSize": "@theme/metric.font.size.md",
      "color": "@theme/color.button.defaultText",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        52
      ]
    },
    {
      "op": "image",
      "scaling": "fit",
      "width": 46,
      "height": 26,
      "align": "right",
      "valign": "center",
      "inset": [
        0,
        16,
        0,
        0
      ],
      "id": "switch_on",
      "opacity": 0,
      "src": "img/switch/switch_on.svg"
    },
    {
      "op": "image",
      "scaling": "fit",
      "width": 46,
      "height": 26,
      "align": "right",
      "valign": "center",
      "inset": [
        0,
        16,
        0,
        0
      ],
      "id": "switch_off",
      "opacity": 1,
      "src": "img/switch/switch_off.svg"
    }
  ],
  "states": {
    "on": {
      "switch_on.opacity": {
        "to": 1,
        "duration": 140
      },
      "switch_off.opacity": {
        "to": 0,
        "duration": 140
      }
    },
    "off": {
      "switch_on.opacity": {
        "to": 0,
        "duration": 140
      },
      "switch_off.opacity": {
        "to": 1,
        "duration": 140
      }
    }
  }
}
