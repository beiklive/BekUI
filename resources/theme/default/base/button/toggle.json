{
  "$comment": "开关按钮：底框来自 base/button/frame，这里只加内容与开关",
  "import": [
    "base/button/frame"
  ],
  "layers": [
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "font_kind": "icon",
      "fontSize": "@theme/metric.buttonVariant.iconSize",
      "color": "@theme/color.button.defaultText",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        20
      ]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "fontSize": "@theme/metric.font.size.md",
      "color": "@theme/color.button.defaultText",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        52
      ]
    },
    {
      "op": "rect",
      "id": "track",
      "fill": "@theme/color.switch.trackOff",
      "radius": 13,
      "width": 46,
      "height": 26,
      "align": "right",
      "valign": "center",
      "inset": [
        0,
        16,
        0,
        0
      ]
    },
    {
      "op": "rect",
      "id": "knob",
      "fill": "@theme/color.switch.knob",
      "radius": 9,
      "width": 18,
      "height": 18,
      "align": "right",
      "valign": "center",
      "inset": [
        0,
        18,
        0,
        0
      ],
      "offset": [
        -22,
        0
      ]
    }
  ],
  "states": {
    "on": {
      "track.fill": {
        "to": "@theme/color.accent.base",
        "duration": 140
      },
      "knob.offsetX": {
        "to": 0,
        "duration": 140,
        "easing": "cubicOut"
      }
    },
    "off": {
      "track.fill": {
        "to": "@theme/color.switch.trackOff",
        "duration": 140
      },
      "knob.offsetX": {
        "to": -22,
        "duration": 140,
        "easing": "cubicOut"
      }
    }
  }
}
