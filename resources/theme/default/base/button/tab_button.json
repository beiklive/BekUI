{
  "box": {
    "height": "@theme/metric.control.height",
    "minWidth": "@theme/metric.control.minWidth"
  },
  "layers": [
    {
      "import": "base/layer/shadow"
    },
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.radius.md"
    },
    {
      "op": "rect",
      "id": "accent",
      "fill": "@theme/color.common.transparent",
      "radius": 8,
      "width": 3,
      "height": 30,
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        0
      ]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "color": "@theme/color.button.defaultText",
      "fontSize": "@theme/metric.button.textSize",
      "align": "center",
      "valign": "center",
      "inset": [
        0,
        25,
        0,
        25
      ]
    }
  ],
  "states": {
    "selected": {
      "accent.fill": {
        "to": "@theme/color.accent.base",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "bg.fill": {
        "to": "@theme/color.state.focus",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "title.color": {
        "to": "@theme/color.accent.base",
        "duration": 140
      }
    },
    "focused": {
      "accent.fill": {
        "to": "@theme/color.accent.base",
        "duration": 0,
        "easing": "quadraticOut"
      }
    }
  }
}
