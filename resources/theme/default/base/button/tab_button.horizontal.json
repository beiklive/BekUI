{
  "box": {
    "height": "@theme/metric.tabCell.height",
    "shrink": 0
  },
  "layers": [
    {
      "import": "base/layer/shadow"
    },
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.radius.md"
    },
    {
      "import": "base/layer/hl_bg"
    },
    {
      "op": "rect",
      "id": "accent",
      "fill": "@theme/color.common.transparent",
      "radius": 2,
      "height": 3,
      "align": "center",
      "valign": "bottom",
      "inset": [
        0,
        10,
        0,
        10
      ]
    },
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.font.size.lg",
      "align": "center",
      "valign": "top",
      "inset": [
        "@theme/metric.spacing.xs",
        0,
        0,
        0
      ],
      "font_kind": "icon"
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "color": "@theme/color.text.dim",
      "fontSize": "@theme/metric.font.size.xs",
      "align": "center",
      "valign": "bottom",
      "inset": [
        0,
        0,
        "@theme/metric.spacing.xs",
        0
      ]
    }
  ],
  "states": {
    "selected": {
      "accent.fill": {
        "to": "@theme/color.accent.base",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "bg.fill": {
        "to": "@theme/color.state.focus",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "title.color": {
        "to": "@theme/color.accent.base",
        "duration": 140
      },
      "icon.color": {
        "to": "@theme/color.accent.base",
        "duration": 140
      }
    },
    "focused": {
      "hlBg.fill": {
        "to": "@theme/color.highlight.background",
        "duration": 120,
        "easing": "quadraticOut"
      }
    }
  }
}
