{
  "box": {
    "height": "@theme/metric.tabCell.height",
    "shrink": 0
  },
  "layers": [
    { "op": "rect", "id": "bg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.radius.md" },

    { "op": "rect", "id": "hlBg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.highlight.radius",
      "inset": [-2.5, -2.5, -2.5, -2.5] },

    { "op": "rect", "id": "accent",
      "fill": "@theme/color.common.transparent",
      "radius": 2,
      "height": 3,
      "align": "center",
      "valign": "bottom",
      "inset": [0, 10, 0, 10] },

    { "op": "text", "id": "icon",
      "source": "icon",
      "color": "@theme/color.text.primary",
      "fontSize": "@theme/metric.font.size.lg",
      "align": "center",
      "valign": "top",
      "inset": ["@theme/metric.spacing.xs", 0, 0, 0] },

    { "op": "text", "id": "title",
      "source": "text",
      "color": "@theme/color.text.dim",
      "fontSize": "@theme/metric.font.size.xs",
      "align": "center",
      "valign": "bottom",
      "inset": [0, 0, "@theme/metric.spacing.xs", 0] },

    { "op": "rect", "id": "hlGlow",
      "stroke": "@theme/color.common.transparent",
      "strokeWidth": 0,
      "radius": "@theme/metric.highlight.radius",
      "inset": [-6.5, -6.5, -6.5, -6.5] },

    { "op": "rect", "id": "hlBorder",
      "stroke": "@theme/color.common.transparent",
      "strokeWidth": 0,
      "radius": "@theme/metric.highlight.radius",
      "inset": [-2.5, -2.5, -2.5, -2.5] }
  ],
  "states": {
    "selected": {
      "accent.fill": { "to": "@theme/color.accent.base", "duration": 140, "easing": "quadraticOut" },
      "bg.fill": { "to": "@theme/color.state.focus", "duration": 140, "easing": "quadraticOut" },
      "title.color": { "to": "@theme/color.accent.base", "duration": 140 },
      "icon.color": { "to": "@theme/color.accent.base", "duration": 140 }
    },
    "focused": {
      "hlBg.fill": { "to": "@theme/color.highlight.background", "duration": 120, "easing": "quadraticOut" }
    }
  }
}
