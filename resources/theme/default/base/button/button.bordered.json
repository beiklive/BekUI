{
  "box": {
    "height": "@theme/metric.control.height",
    "minWidth": "@theme/metric.control.minWidth"
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.radius.md",
      "stroke": "@theme/color.button.defaultBorder",
      "strokeWidth": "@theme/metric.button.borderThickness"
    },
    {
      "op": "rect",
      "id": "hlBg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "color": "@theme/color.button.defaultText",
      "fontSize": "@theme/metric.button.textSize",
      "align": "center",
      "valign": "center",
      "inset": [
        0,
        25,
        0,
        25
      ]
    },
    {
      "op": "rect",
      "id": "hlGlow",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -6.5,
        -6.5,
        -6.5,
        -6.5
      ]
    },
    {
      "op": "rect",
      "id": "hlBorder",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.highlight.radius",
      "inset": [
        -2.5,
        -2.5,
        -2.5,
        -2.5
      ]
    }
  ],
  "states": {
    "focused": {
      "hlBg.fill": {
        "to": "@theme/color.highlight.background",
        "duration": 120,
        "easing": "quadraticOut"
      }
    },
    "disabled": {
      "bg.fill": {
        "to": "@theme/color.state.disabled",
        "duration": 150
      },
      "title.color": {
        "to": "@theme/color.text.disabled",
        "duration": 150
      },
      "bg.stroke": {
        "to": "@theme/color.button.disabledBorder",
        "duration": 150
      }
    }
  }
}
