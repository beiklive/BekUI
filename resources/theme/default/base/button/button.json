{
  "$comment": "抽象按钮的基础外观：只画背景 / 边框 / 阴影三层（都来自 base/layer/），不含任何内容层。具体形态（text / icon / icon_text …）import 这份再加自己的内容层。",
  "requires": {
    "layers": [
      { "shadow": "shadow" },
      { "bg": "rect" },
      { "border": "rect" }
    ]
  },
  "box": {
    "height": "@theme/metric.control.height",
    "minWidth": "@theme/metric.control.minWidth"
  },
  "layers": [
    {
      "import": "base/layer/glass"
    },
    {
      "import": "base/layer/bg",
      "fill": "@theme/color.button.defaultBg",
      "fill": "@theme/color.common.transparent"
    },
    {
      "import": "base/layer/border",
      "stroke": "@theme/color.button.defaultBorder"
    }
  ],
  "states": {
    "focused": {},
    "pressed": {
      "bg.fill": {
        "to": "@theme/color.button.defaultPressedBg",
        "duration": 60
      },
      "self": {
        "translateX": { "to": 3, "duration": 60, "easing": "cubicOut" },
        "translateY": { "to": 3, "duration": 60, "easing": "cubicOut" }
      }
    },
    "disabled": {}
  }
}
