{
  "box": {
    "height": "@theme/metric.control.height",
    "minWidth": "@theme/metric.control.minWidth"
  },
  "layers": [
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.button.defaultBg",
      "radius": "@theme/metric.radius.md"
    },
    {
      "import": "base/layer/hl_bg"
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "color": "@theme/color.button.defaultText",
      "fontSize": "@theme/metric.button.textSize",
      "align": "center",
      "valign": "center",
      "inset": [
        0,
        25,
        0,
        25
      ]
    }
  ],
  "states": {
    "focused": {},
    "pressed": {
      "bg.fill": {
        "to": "@theme/color.button.defaultPressedBg",
        "duration": 60
      },
      "title.color": {
        "to": "@theme/color.button.defaultText",
        "duration": 60
      }
    },
    "disabled": {}
  }
}
