{
  "$comment": "LR 按钮：底框来自 base/button/frame；L/值/R 由代码按控件宽度绘制（custom 层）",
  "import": [
    "base/button/frame"
  ],
  "layers": [
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "font_kind": "icon",
      "fontSize": "@theme/metric.buttonVariant.iconSize",
      "color": "@theme/color.button.defaultText",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        20
      ]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "fontSize": "@theme/metric.font.size.md",
      "color": "@theme/color.button.defaultText",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        52
      ]
    },
    {
      "op": "custom",
      "id": "lr",
      "fill": "@theme/color.text.primary",
      "fontSize": 18
    }
  ]
}
