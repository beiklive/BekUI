{
  "$comment": "自定义右侧信息按钮：底框来自 base/button/frame",
  "import": [
    "base/button/frame"
  ],
  "layers": [
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "font_kind": "icon",
      "fontSize": "@theme/metric.buttonVariant.iconSize",
      "color": "@theme/color.button.defaultText",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        20
      ]
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "fontSize": "@theme/metric.font.size.md",
      "color": "@theme/color.button.defaultText",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        52
      ]
    },
    {
      "op": "text",
      "id": "info",
      "data_id": "info",
      "fontSize": "@theme/metric.buttonVariant.infoFontSize",
      "color": "@theme/color.text.dim",
      "align": "right",
      "valign": "center",
      "inset": [
        0,
        16,
        0,
        0
      ]
    }
  ]
}
