{
  "box": {
    "height": "@theme/metric.sidebar.itemHeight",
    "shrink": 0
  },
  "layers": [
    {
      "import": "base/layer/shadow"
    },
    {
      "op": "rect",
      "id": "bg",
      "fill": "@theme/color.common.transparent",
      "radius": "@theme/metric.radius.md"
    },
    {
      "import": "base/layer/hl_bg"
    },
    {
      "op": "rect",
      "id": "accent",
      "fill": "@theme/color.common.transparent",
      "radius": 2,
      "width": "@theme/metric.sidebar.accentWidth",
      "align": "left",
      "inset": [
        "@theme/metric.sidebar.accentMarginY",
        0,
        "@theme/metric.sidebar.accentMarginY",
        "@theme/metric.sidebar.accentMarginX"
      ]
    },
    {
      "op": "text",
      "id": "icon",
      "data_id": "icon",
      "color": "@theme/color.text.dim",
      "fontSize": "@theme/metric.sidebar.iconSize",
      "width": "@theme/metric.sidebar.iconSize",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        "@theme/metric.sidebar.iconInset"
      ],
      "font_kind": "icon"
    },
    {
      "op": "text",
      "id": "title",
      "data_id": "text",
      "color": "@theme/color.text.dim",
      "fontSize": "@theme/metric.font.size.md",
      "align": "left",
      "valign": "center",
      "inset": [
        0,
        0,
        0,
        "@theme/metric.sidebar.titleInset"
      ]
    }
  ],
  "states": {
    "selected": {
      "accent.fill": {
        "to": "@theme/color.accent.base",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "bg.fill": {
        "to": "@theme/color.state.focus",
        "duration": 140,
        "easing": "quadraticOut"
      },
      "title.color": {
        "to": "@theme/color.text.primary",
        "duration": 140
      },
      "icon.color": {
        "to": "@theme/color.text.primary",
        "duration": 140
      }
    },
    "focused": {
      "hlBg.fill": {
        "to": "@theme/color.highlight.background",
        "duration": 120,
        "easing": "quadraticOut"
      }
    }
  }
}
