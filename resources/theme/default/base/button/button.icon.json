{
  "$comment": "图标按钮：背景 / 边框 / 阴影继承 base/button/button，这里只改盒子尺寸并加 m_icon 内容层。",
  "import": "base/button/button",
  "requires": {
    "layers": [
      { "icon": "text" }
    ]
  },
  "box": {
    "width": "@theme/metric.control.height",
    "height": "@theme/metric.control.height",
    "minWidth": 0,
    "padding": 0,
    "axis": "row",
    "alignItems": "center",
    "justifyContent": "center"
  },
  "layers": [
    {
      "op": "text",
      "id": "icon",
      "data_id": "m_icon",
      "font_kind": "icon",
      "fontSize": "@theme/metric.buttonVariant.iconSize",
      "color": "@theme/color.button.defaultText",
      "align": "center",
      "valign": "center"
    }
  ]
}
